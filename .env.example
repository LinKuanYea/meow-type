# 主機上要用的 port（只綁 127.0.0.1）。deploy.sh 會先檢查有沒有被佔用。喵推用 38217，這裡用 38218。
HOST_PORT=38218
# 管理頁 /admin（統計、Google 登入設定、資料匯出）的密碼。沒設定 ADMIN_PASSWORD 就用 STATS_PASSWORD；兩個都沒設定就不開放管理頁。
ADMIN_PASSWORD=
# 管理頁停用密碼登入後，萬一 Google 登入壞掉進不來：設成 1 重新部署可以暫時用密碼登入，處理完請拿掉
ADMIN_PASSWORD_RESCUE=
STATS_PASSWORD=
# 同一個 IP 每分鐘最多幾個請求（學校全班共用一個對外 IP，不要設太低）
RATE_PER_MIN=1500
# Google 登入（選填）：建議直接在管理頁 /admin →「Google 登入」設定（存在資料庫、馬上生效）。
# 這裡的環境變數只在管理頁沒設定時才用。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://meow-type.otlab.org
