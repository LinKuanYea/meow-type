# 主機上要用的 port（只綁 127.0.0.1）。deploy.sh 會先檢查有沒有被佔用。喵推用 38217，這裡用 38218。
HOST_PORT=38218
# 統計頁 /stats 的密碼（帳號隨便填）。沒設定就不開放統計頁。
STATS_PASSWORD=
# 同一個 IP 每分鐘最多幾個請求（學校全班共用一個對外 IP，不要設太低）
RATE_PER_MIN=1500
# Google 登入（選填，三個都設定才會出現登入按鈕）
# Google Cloud → Google Auth Platform → 用戶端 → 網頁應用程式；已授權的重新導向 URI 填 https://meow-type.otlab.org/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_URL=https://meow-type.otlab.org
